# Quarantine.cmake — label the tests listed in tests/quarantine.txt `quarantine` so the CI gate
# (`ctest -LE quarantine`) skips them while a report-only run (`ctest -L quarantine`) still
# executes them. Call xp_quarantine_tests(<file>) at the END of the tests' CMakeLists.txt.
#
# Two kinds of tests need two mechanisms (CTestTestfile loads TEST_INCLUDE_FILES before its own
# add_test lines):
#   * tests known at configure time (add_test)          -> labelled here, directly
#   * tests discovered at ctest time (catch_discover_tests PRE_TEST) -> a generated include file
#     that runs after the discovery include and sets the label then
# Names that match nothing are ignored here; `xptools quarantine check --preset` reports them.
function(xp_quarantine_tests list_file)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${list_file}")
  file(STRINGS "${list_file}" lines REGEX "^[^#].*[|]")
  set(script "# generated by cmake/Quarantine.cmake from ${list_file}\n")
  foreach(line IN LISTS lines)
    string(REGEX REPLACE "[|].*$" "" name "${line}")
    string(STRIP "${name}" name)
    if(TEST "${name}")
      set_property(TEST "${name}" APPEND PROPERTY LABELS quarantine)
    else()
      # discovered later: LABELS is replaced, which is fine (discovered tests carry no labels here)
      string(APPEND script "set_tests_properties([==[${name}]==] PROPERTIES LABELS quarantine)\n")
    endif()
  endforeach()
  set(out "${CMAKE_CURRENT_BINARY_DIR}/xp_quarantine.cmake")
  file(WRITE "${out}" "${script}")
  set_property(DIRECTORY APPEND PROPERTY TEST_INCLUDE_FILES "${out}")
endfunction()
